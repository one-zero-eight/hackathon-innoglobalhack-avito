# Selectel Jev settings from projacktor/main. Keep provider credentials separate.
JEV_PROVIDER=selectel
JEV_MODEL=typesafe/jev-1.13
SELECTEL_API_KEY=
LLM_MODEL_ID=gemini-decision-1
LLM_API_KEY=
# Генератор sample_llm берёт ключ из LLM_API_KEY (Google Gemini); опционально:
# SAMPLE_LLM_MODEL_ID=gemini-3.5-flash-lite
# SAMPLE_LLM_TIMEOUT=60
# SAMPLE_LLM_MAX_ATTEMPTS=4
# SAMPLE_LLM_RETRY_DELAY=10
GOOGLE_DECISION_PROMPT=guided
GOOGLE_DECISION_THRESHOLD=0.5
BESTAPI_API_KEY=
JEV_ENDPOINT=https://api.selectel.ru/aig/v1/decisions
JEV_THRESHOLD=0.5
# jev_calibrated: auto loads its model-specific train calibration artifact.
JEV_CALIBRATED_PROMPT=auto
JEV_TFIDF_WEIGHT=0.5
JEV_TFIDF_THRESHOLD=0.5
STRUCTURED_LLM_MODEL=gpt-6.1-terra
# 1 — явно повторить JSON Schema в system prompt для провайдеров без строгого schema decoding.
STRUCTURED_LLM_SCHEMA_IN_PROMPT=0
STRUCTURED_LLM_ENDPOINT=https://bestapi.fugue.pro/v1/chat/completions
JEV_REFERENCE_DATASET=out/hybrid-training.jsonl
JEV_REFERENCE_MAX_CHARS=1800
SEMANTIC_ENCODER_ARTIFACT_PATH=out/semantic-encoder
SEMANTIC_ENCODER_DEVICE=auto
# JSON-тарифы USD по точному endpoint+model; без файла стоимость новых API-вызовов неизвестна.
LLM_PRICING_FILE=
RUBERT_F1_ARTIFACT_PATH=src/subcategory_extraction/semantic/semantic_encoder_f1/artifacts
RUBERT_F1_DEVICE=cpu
# Qwen Token Plan: нативный System One, отдельный ключ от BestAPI/Google.
QIANWEN_TOKEN_PLAN_API_KEY=
QWEN_DECISION_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_DECISION_MODEL=decision-model-preview
QWEN_DECISION_TIMEOUT=60
QWEN_DECISION_MAX_ATTEMPTS=3
# auto применяет сохранённую train-калибровку; guided/boundaries используют порог 0.5.
QWEN_DECISION_PROMPT=auto

# --- PostgreSQL (общие датасеты проекта) ---
# Таблицы: case_train, case_test, manual_train, manual_test, yandex_yoola.
# Все таблицы в едином формате (description + mc_ids + source + extra).
# Наполнение: uv run python src/database_load.py
# Реальные креды — только в локальном .env (не коммитим).
DB_HOST=31.56.208.237
DB_PORT=5433
DB_NAME=avito
DB_USER=avito
DB_PASSWORD=
DB_SSLMODE=prefer

# feder-cr/jev: отдельный локальный сервер, без ключей облачного Jev.
LOCAL_JEV_BASE_URL=http://127.0.0.1:8017
LOCAL_JEV_MODEL=jevos-v5
LOCAL_JEV_PROMPT=english
LOCAL_JEV_THRESHOLD=0.5
LOCAL_JEV_TIMEOUT=120
LOCAL_JEV_API_KEY=
LOCAL_JEV_AUTOSTART=1
LOCAL_JEV_THREADS=4
# LOCAL_JEV_CACHE_DIR=out/local-jev

# Локальный HTTP API без Docker: uv run uvicorn api.app:app --app-dir src --port 8000; Swagger /docs.
# --- Веб-сервис черновиков (docker-compose) ---
# Строка подключения к PostgreSQL; для docker-compose внутри сети: db:5432
DATABASE_URL=postgresql://avito:avito@localhost:5432/avito
# Qwen3.5-9B: внешний локальный OpenAI-совместимый runtime (ставится отдельно).
# Для CLI/dev — loopback; compose по умолчанию использует host.docker.internal.
# LOCAL_LLM_API_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_LLM_MODEL_ID=default_model
LOCAL_LLM_TIMEOUT=180
LOCAL_LLM_MAX_TOKENS=4096
# Порты сервисов: API и веб-клиента (веб на хосте 8081, 8080 бывает занят)
API_PORT=8000
WEB_PORT=8081

