JEV_MODEL=jev-1.13.0
LLM_MODEL_ID=gemini-decision-1
LLM_API_KEY=
GOOGLE_DECISION_PROMPT=guided
GOOGLE_DECISION_THRESHOLD=0.5
BESTAPI_API_KEY=
JEV_ENDPOINT=https://bestapi.fugue.pro/v1/systemone
JEV_THRESHOLD=0.5
JEV_TFIDF_WEIGHT=0.5
JEV_TFIDF_THRESHOLD=0.5
STRUCTURED_LLM_MODEL=gpt-6.1-terra
STRUCTURED_LLM_ENDPOINT=https://bestapi.fugue.pro/v1/chat/completions
JEV_REFERENCE_DATASET=out/hybrid-training.jsonl
JEV_REFERENCE_MAX_CHARS=1800
SEMANTIC_ENCODER_ARTIFACT_PATH=out/semantic-encoder
SEMANTIC_ENCODER_DEVICE=auto
# JSON-тарифы USD по точному endpoint+model; без файла стоимость новых API-вызовов неизвестна.
LLM_PRICING_FILE=
RUBERT_F1_ARTIFACT_PATH=src/subcategory_extraction/semantic_encoder_f1/artifacts
RUBERT_F1_DEVICE=cpu
# Qwen Token Plan: нативный System One, отдельный ключ от BestAPI/Google.
QIANWEN_TOKEN_PLAN_API_KEY=
QWEN_DECISION_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_DECISION_MODEL=decision-model-preview
QWEN_DECISION_TIMEOUT=60
QWEN_DECISION_MAX_ATTEMPTS=3
# auto применяет сохранённую train-калибровку; guided/boundaries используют порог 0.5.
QWEN_DECISION_PROMPT=auto
# feder-cr/jev: отдельный локальный сервер, без ключей облачного Jev.
LOCAL_JEV_BASE_URL=http://127.0.0.1:8017
LOCAL_JEV_MODEL=jevos-v5
LOCAL_JEV_PROMPT=english
LOCAL_JEV_THRESHOLD=0.5
LOCAL_JEV_TIMEOUT=120
LOCAL_JEV_API_KEY=
LOCAL_JEV_AUTOSTART=1
LOCAL_JEV_THREADS=4
# LOCAL_JEV_CACHE_DIR=out/local-jev
