LLM_MODEL_ID=gemini-decision-1
LLM_API_KEY=

# HTTP server: uv run python -m src
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Extraction overrides; blank key falls back to LLM_API_KEY, then GOOGLE_API_KEY.
EXTRACTION_PROMPT=guided
EXTRACTION_THRESHOLD=0.5
EXTRACTION_MODEL_ID=gemini-decision-1
EXTRACTION_API_KEY=
EXTRACTION_API_URL=https://generativelanguage.googleapis.com/v1beta/decisions
EXTRACTION_TIMEOUT=60
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_DELAY=1

# Google text generation. Blank key falls back to GOOGLE_API_KEY, then LLM_API_KEY.
GENERATION_PROVIDER=google
GENERATION_MODEL_ID=gemma-4-31b-it
GENERATION_API_KEY=
# Blank URL uses the Google GenerateContent URL for GENERATION_MODEL_ID.
GENERATION_API_URL=
GENERATION_TIMEOUT=60
GENERATION_MAX_ATTEMPTS=3
GENERATION_RETRY_DELAY=1
# prompt | json_object | json_schema; enable API constraints only if supported.
GENERATION_RESPONSE_MODE=prompt

# For OpenAI-compatible generation, set GENERATION_PROVIDER=openai_compatible,
# GENERATION_MODEL_ID, GENERATION_API_KEY, and the complete GENERATION_API_URL
# ending in /chat/completions. No key/model/endpoint fallback is used.
